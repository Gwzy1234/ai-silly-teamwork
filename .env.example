# Application
APP_NAME=Silly Teamwork API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Generate a new value before deploying:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL (async SQLAlchemy driver)
DATABASE_URL=postgresql+asyncpg://silly_teamwork:silly_teamwork@localhost:5432/silly_teamwork
DB_ECHO=false

# Comma-separated values are accepted by pydantic-settings as a JSON array.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Files
UPLOAD_DIR=uploads
MAX_FILE_SIZE=20971520
MAX_AVATAR_SIZE=5242880
MAX_UPLOAD_SIZE_MB=20

# Legacy deadline scanner (disabled when the independent scheduler is used)
DEADLINE_REMINDERS_ENABLED=false
DEADLINE_REMINDER_INTERVAL_SECONDS=300
DEADLINE_DUE_SOON_HOURS=72

# Independent notification scheduler
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_SCHEDULER_BATCH_SIZE=100
NOTIFICATION_SCHEDULER_LEASE_SECONDS=300
NOTIFICATION_SCHEDULER_MAX_ATTEMPTS=5

# AI assistant (Xiaomi MiMo API, OpenAI-compatible protocol)
# Keep AI_LLM_API_KEY only in backend environment variables; never expose it to the frontend.
AI_LLM_ENABLED=false
AI_LLM_API_KEY=
# Leave empty to use the built-in default: https://api.xiaomimimo.com/v1
AI_LLM_BASE_URL=
AI_LLM_MODEL=
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_MAX_TOKENS=2000

# Development seed (used only when ENVIRONMENT=development)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456
SEED_ADMIN_NICKNAME=Administrator
SEED_TEAM_NAME=Silly Teamwork Development Team
SEED_INVITE_CODE=ST-DEV-2026
